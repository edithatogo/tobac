#!/bin/sh
# Repository-owned guard; stdin is Git's exact pushed-ref list.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
.venv/bin/python -c 'import sys; assert sys.version_info[:3] == (3, 15, 1)'
exec .venv/bin/python scripts/run_bounded.py --max-rss-mib 4096 --timeout 2400 -- .venv/bin/python scripts/check_publication_security.py --pre-push
