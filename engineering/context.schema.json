{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded repository context profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "max_bytes", "paths", "base_commit"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,40}$"},
    "max_bytes": {"type": "integer", "minimum": 1024, "maximum": 150000},
    "paths": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}},
    "base_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"}
  }
}
