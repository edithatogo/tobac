{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "quit_points",
    "crime_weights",
    "resource_weights",
    "challenges",
    "scientific_status"
  ],
  "properties": {
    "schema": {
      "const": "tobac.m2-robustness.v1"
    },
    "quit_points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "crime_weights": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "resource_weights": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "challenges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "high_probabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "illicit": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "diversion": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "crime": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          },
          "coupling": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "null_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "information_retained": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "report_dependence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "scientific_status": {
      "type": "string",
      "minLength": 1
    }
  }
}
