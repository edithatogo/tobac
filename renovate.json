{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "matchPackageNames": [
        "numpy",
        "scipy",
        "pandas",
        "matplotlib",
        "voiage"
      ],
      "groupName": "scientific stack qualification",
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "verified action pins",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "ruff",
        "basedpyright",
        "nox",
        "hypothesis",
        "pip-audit",
        "zizmor",
        "mutmut",
        "scalene"
      ],
      "groupName": "engineering tools",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "polars",
        "polars-runtime-32",
        "pyarrow",
        "patito",
        "msgspec",
        "pydantic",
        "xarray"
      ],
      "groupName": "evidence transport qualification",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "scikit-learn",
        "scipy-stubs",
        "joblib",
        "narwhals",
        "threadpoolctl"
      ],
      "groupName": "synthetic analytical qualification",
      "automerge": false
    }
  ],
  "enabled": true,
  "dependencyDashboard": true,
  "pip_requirements": {
    "managerFilePatterns": [
      "/^engineering/(requirements|audit|voiage|ecosystem|analytics|clustering)\\.in$/",
      "/^engineering/tools-requirements\\.txt$/"
    ]
  },
  "prBodyNotes": [
    "Renovate is the sole dependency-update PR provider. Update canonical declarations and matching engineering profiles together.",
    "After dependency-input changes, regenerate and review every affected source-bound lock, including opt-in analytics, clustering and advisory profiles. Preserve the four-profile snapshot contract. Existing Python, native-library, security and hosted checks must pass before merge."
  ]
}
